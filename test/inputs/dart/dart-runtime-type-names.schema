      "type": "object",
      "properties": {
        "value": {
          "type": "integer"
        }
      },
      "required": [
        "value"
      ]
    },
    "enumValues": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        }
      },
      "required": [
        "label"
      ]
    },
    "formatException": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer"
        }
      },
      "required": [
        "count"
      ]
    },
    "regExp": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        }
      },
      "required": [
        "active"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ready",
        "done"
      ]
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z]+$",
      "minLength": 1
    }
  },
  "required": [
