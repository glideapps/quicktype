{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "EmptyInterfaces",
    "type": "object",
    "properties": {
        "a1": {
            "type": "object",
            "additionalProperties": true,
            "patternProperties": {
                "^.+$": {
                    "type": "string"
                }
            }
        },
        "a2": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
                "^.+$": {
                    "type": "string"
                }
            }
        },
        "a3": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
                "^.+$": {
                    "type": "integer"
                }
            }
        }
    }
}
