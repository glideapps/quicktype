{
  "type": "object",
  "properties": {
    "pattern1": {
      "type": "string",
      "pattern": "a[.]*"
    },
    "pattern2": {
      "type": "string",
      "pattern": "b[.]*"
    },
    "escaped": {
      "type": "string",
      "pattern": "^\\d+\\.[a-z]+$"
    },
    "union": {
      "oneOf": [
        {
          "$ref": "#/properties/pattern2"
        },
        {
          "type": "string",
          "pattern": "c[.]*"
        }
      ]
    }
  },
  "required": ["pattern1", "pattern2", "escaped", "union"]
}
