        "mango": { "type": "number" },
        "apple": { "type": "boolean" },
        "delta": { "type": "string" },
        "banana": { "type": "integer" },
        "ordered": {
            "type": "object",
            "quicktypePropertyOrder": ["mango", "zebra"],
            "properties": {
                "zebra": { "type": "string" },
                "mango": { "type": "number" },
                "apple": { "type": "boolean" }
