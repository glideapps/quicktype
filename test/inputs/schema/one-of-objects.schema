{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OneOfObjects",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "aa": { "type": "string" },
              "bb": { "type": "string" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cc": { "type": "string" },
              "dd": { "type": "string" }
            }
          }
        ]
      }
    }
  }
}
